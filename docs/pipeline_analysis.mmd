flowchart TB
    %% Inside the analysis: from sweeps.csv rows to tables and figures

    CSV[("sweeps.csv<br/>all windows, incl. rejected attempts<br/>and the 4 replaced originals")]

    subgraph LOAD["load() in final_summary.py"]
        direction TB
        L1["keep rows with block_status = ok"]
        L2["group into blocks<br/>key = (session, run, rate, mrpc)<br/>value = {setup: row}, 5 rows per block"]
        L3["apply replacements.csv<br/>session-5 block -> key of the original"]
        L4["store _key in every block<br/>= 112 blocks, 8 per grid point"]
        L1 --> L2 --> L3 --> L4
    end
    CSV --> L1

    L4 --> Q["quality()<br/>windows, errors, gate per session,<br/>calib, resumed share, curve evidence"]
    L4 --> OUT["outliers()<br/>median / MAD rule per point<br/>now: 0 blocks"]

    subgraph PAIR["Paired in each block (machine state cancels)"]
        direction TB
        P1["ratio: (A / B - 1) x 100%<br/>PQ vs X25519, TLS vs plaintext"]
        P2["hs_cost(): CPU per handshake<br/>[(A - B)(mrpc) - (A - B)(keep-alive)] x mrpc"]
    end
    OUT --> P1
    OUT --> P2

    subgraph RUNS["Over the 8 runs"]
        direction TB
        C1["ci(): mean +- t x SD / sqrt(n)<br/>t = 2.365 for n = 8"]
        C2["median as robust check"]
        C3["latency: median + IQR (no CI)"]
        C4["per_run(): average over offered loads<br/>inside a run first (f3, f4, f6)"]
    end
    P1 --> C1
    P1 --> C2
    P2 --> C4 --> C1
    OUT --> C3

    C1 --> T["summary.txt tables<br/>table_pct, table_handshake_cost,<br/>table_latency, table_memory"]
    C2 --> T
    C3 --> T

    subgraph FIG["plot_final.py figures"]
        direction TB
        F1["f1 CPU per request"]
        F2["f2, f2b PQ overhead %"]
        F3["f3, f3b cost per handshake"]
        F4["f4 mTLS vs plaintext"]
        F5["f5a/b/c latency"]
        F6["f6 memory"]
        F9["f9 client vs server"]
    end
    C1 --> F1 & F2 & F3 & F4 & F6 & F9
    C3 --> F5

    GATE[("gate.csv")] --> ST["STATE per block<br/>entry canary vs lowest level of the point<br/>below 9% = fast, else slow"]
    ST --> F7["f7, f7b, f7c machine states"]
